{
  "name": "statuspage-embed",
  "description": "Embeddable StatusPage widget for NYU Libraries",
  "scripts": {
    "build": "vite build && rm dist/index.html",
    "dev": "vite dev",
    "eslint": "eslint . --ext .js,.jsx,.cjs,.mjs",
    "eslint:fix": "npm run eslint -- --fix",
    "statuspage-proxy": "node ./tools/statuspage-summary-cors-proxy.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "cd test/e2e/ && npm run test",
    "test:e2e:update-golden-files": "cd test/e2e/ && npm run test:update-golden-files",
    "test:unit": "cd test/unit/ && npm run test",
    "test:unit:watch": "cd test/unit/ && npm run test:watch"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.2",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.7.1",
    "eslint": "10.0.0",
    "globals": "17.3.0",
    "vite": "8.0.0"
  }
}
